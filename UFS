getgenv().IY_Style_Freecam = trackConnection(RunService.RenderStepped:Connect(function(dt)
    if not active then return end

    local fovLerpSpeed = math.clamp(movementSmoothness, 1, 30)
    camera.FieldOfView = camera.FieldOfView + (targetFov - camera.FieldOfView) * math.clamp(dt * fovLerpSpeed, 0, 1)

    local isPanActive = mouseLocked or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if isPanActive then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        local delta = UserInputService:GetMouseDelta()
        targetRotationX = targetRotationX - (delta.X * sensitivity)
        targetRotationY = math.clamp(targetRotationY - (delta.Y * sensitivity), -85, 85)
    else
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
    
    local currentForwardSpeed = tonumber(forwardSpeed) or 1.0
    local currentSideSpeed = tonumber(sideSpeed) or 1.0

    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        currentForwardSpeed = currentForwardSpeed * shiftMultiplier
        currentSideSpeed = currentSideSpeed * shiftMultiplier
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        currentForwardSpeed = currentForwardSpeed / slowMultiplier
        currentSideSpeed = currentSideSpeed / slowMultiplier
    end

    -- GLIDE / SMOOTH INPUT LOGIC
    local moveLerp = math.clamp(movementSmoothness, 1, 30)
    local lerpAlpha = math.clamp(dt * moveLerp, 0, 1)
    
    if not tripodMode then
        smoothedMovement.W = smoothedMovement.W + (movement.W - smoothedMovement.W) * lerpAlpha
        smoothedMovement.S = smoothedMovement.S + (movement.S - smoothedMovement.S) * lerpAlpha
        smoothedMovement.A = smoothedMovement.A + (movement.A - smoothedMovement.A) * lerpAlpha
        smoothedMovement.D = smoothedMovement.D + (movement.D - smoothedMovement.D) * lerpAlpha
        smoothedMovement.E = smoothedMovement.E + (movement.E - smoothedMovement.E) * lerpAlpha
        smoothedMovement.Q = smoothedMovement.Q + (movement.Q - smoothedMovement.Q) * lerpAlpha
        smoothedMovement.Z = smoothedMovement.Z + (movement.Z - smoothedMovement.Z) * lerpAlpha
        smoothedMovement.X = smoothedMovement.X + (movement.X - smoothedMovement.X) * lerpAlpha
    else
        for k in pairs(smoothedMovement) do
            smoothedMovement[k] = 0
        end
    end

    rotationZ = rotationZ + (tiltSpeed * dt * (smoothedMovement.Z - smoothedMovement.X))

    local trackingCenter = getTrackingCenter()
    
    if trackingCenter then
        local framedCenter = trackingCenter + Vector3.new(0, cameraHeightOffset, 0)
        
        if tripodMode then
            local lookCFrame = CFrame.lookAt(camCFrame.Position, framedCenter) * CFrame.Angles(0, 0, math.rad(rotationZ))
            local mappedLerpSpeed = 31 - math.clamp(smoothingWeight, 1, 30)
            camera.CFrame = camera.CFrame:Lerp(lookCFrame, math.clamp(dt * mappedLerpSpeed, 0, 1))

            local rx, ry, _ = camera.CFrame:ToEulerAnglesYXZ()
            targetRotationX = math.deg(ry)
            targetRotationY = math.clamp(math.deg(rx), -85, 85)
            rotationX = targetRotationX
            rotationY = targetRotationY
        else
            local sideAngularSpeed = currentSideSpeed * 65 * dt 
            local forwardZoomSpeed = currentForwardSpeed * 10 * dt
            local verticalAngularSpeed = sideAngularSpeed * verticalSpeed
            
            targetOrbitDistance = math.max(targetOrbitDistance + (forwardZoomSpeed * (smoothedMovement.S - smoothedMovement.W)), 2)
            
            local distanceLerpSpeed = math.clamp(movementSmoothness, 1, 30)
            orbitDistance = orbitDistance + (targetOrbitDistance - orbitDistance) * math.clamp(dt * distanceLerpSpeed, 0, 1)

            targetRotationX = targetRotationX + (sideAngularSpeed * (smoothedMovement.D - smoothedMovement.A))
            targetRotationY = math.clamp(targetRotationY + (verticalAngularSpeed * (smoothedMovement.Q - smoothedMovement.E)), -85, 85)

            local panLerpSpeed = math.clamp(mouseSmoothness, 1, 30)
            rotationX = rotationX + (targetRotationX - rotationX) * math.clamp(dt * panLerpSpeed, 0, 1)
            rotationY = rotationY + (targetRotationY - rotationY) * math.clamp(dt * panLerpSpeed, 0, 1)

            local rotationMatrix = CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0) * CFrame.Angles(0, 0, math.rad(rotationZ))
            local targetPos = framedCenter + (rotationMatrix * Vector3.new(0, 0, orbitDistance))
            
            camCFrame = CFrame.new(targetPos) * rotationMatrix
            
            local mappedLerpSpeed = 31 - math.clamp(smoothingWeight, 1, 30)
            camera.CFrame = camera.CFrame:Lerp(camCFrame, math.clamp(dt * mappedLerpSpeed, 0, 1))
        end
    else
        if not tripodMode then
            local horizontalDirection = Vector3.new((smoothedMovement.D - smoothedMovement.A) * currentSideSpeed, 0, (smoothedMovement.S - smoothedMovement.W) * currentForwardSpeed)
            local moveMatrix = CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0)
            
            local moveVector = moveMatrix:VectorToWorldSpace(horizontalDirection) * (15 * dt)
            moveVector = moveVector + Vector3.new(0, (smoothedMovement.E - smoothedMovement.Q) * (currentForwardSpeed * verticalSpeed * 15 * dt), 0)
            camCFrame = camCFrame + moveVector
        end

        local panLerpSpeed = math.clamp(mouseSmoothness, 1, 30)
        rotationX = rotationX + (targetRotationX - rotationX) * math.clamp(dt * panLerpSpeed, 0, 1)
        rotationY = rotationY + (targetRotationY - rotationY) * math.clamp(dt * panLerpSpeed, 0, 1)

        local rotationMatrix = CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0) * CFrame.Angles(0, 0, math.rad(rotationZ))
        local rawTargetCFrame = CFrame.new(camCFrame.Position) * rotationMatrix
        if isPanActive then
            camera.CFrame = rawTargetCFrame
        else
            camera.CFrame = camera.CFrame:Lerp(rawTargetCFrame, math.clamp(dt * 15, 0, 1))
        end
    end
end))

