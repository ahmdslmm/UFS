-- ============================================================
function updatePlayerVisibility(p)
    if not p or not p.Character then return end
    local isHidden = (hiddenPlayers[p.UserId] == true)
    for _, v in ipairs(p.Character:GetDescendants()) do
        if v:IsA("BasePart") then
            v.LocalTransparencyModifier = isHidden and 1 or 0
        elseif v:IsA("Decal") then
            v.Transparency = isHidden and 1 or 0
        elseif v:IsA("BillboardGui") or v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") or v:IsA("Highlight") then
            v.Enabled = not isHidden
        end
    end
end

function updateAllPlayersVisibility()
    for _, p in ipairs(Players:GetPlayers()) do
        updatePlayerVisibility(p)
    end
end

local function syncHideAllButtonState()
    local total = 0
    local hiddenCount = 0
    for _, p in ipairs(Players:GetPlayers()) do
        total = total + 1
        if hiddenPlayers[p.UserId] then
            hiddenCount = hiddenCount + 1
        end
    end

    if total > 0 and hiddenCount == total then
        HideAllPlayersButton.Text = "HIDE ALL : ON"
        HideAllPlayersButton.BackgroundColor3 = Color3.fromRGB(70, 200, 55)
    else
        HideAllPlayersButton.Text = "HIDE ALL : OFF"
        HideAllPlayersButton.BackgroundColor3 = Color3.fromRGB(40, 90, 180)
    end
end

HideAllPlayersButton.MouseButton1Click:Connect(function()
    local allCurrentlyHidden = true
    for _, p in ipairs(Players:GetPlayers()) do
        if not hiddenPlayers[p.UserId] then
            allCurrentlyHidden = false
            break
        end
    end

    local targetState = not allCurrentlyHidden
    for _, p in ipairs(Players:GetPlayers()) do
        hiddenPlayers[p.UserId] = targetState
    end

    updateAllPlayersVisibility()
    refreshPlayerList()
end)

