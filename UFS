local function ApplyColorGrading()
    local r, g, b = 1, 1, 1
    if currentTemp > 0 then local f = currentTemp/100; b = b - (0.35*f); g = g - (0.08*f)
    elseif currentTemp < 0 then local f = math.abs(currentTemp)/100; r = r - (0.35*f); g = g - (0.12*f) end
    if currentTint > 0 then local f = currentTint/100; g = g - (0.28*f)
    elseif currentTint < 0 then local f = math.abs(currentTint)/100; r = r - (0.20*f); b = b - (0.20*f) end
    cc.TintColor = Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end

