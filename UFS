        KeysContainer.Size = UDim2.new(1, 0, 0, keysH)
        
        BottomContainer.Position = UDim2.new(0, 0, 0, targetBottomY)
        if not minimized then
            MainCanvas.Size = UDim2.new(0, FULL_CANVAS_WIDTH, 0, totalCanvasH)
        end
    end

    SlidersToggleBtn.Text = slidersOpen and "▼  SLIDERS CONFIGURATION" or "▶  SLIDERS CONFIGURATION"
    VisualsToggleBtn.Text = visualsOpen and "▼  VISUAL CONFIGURATION" or "▶  VISUAL CONFIGURATION"
    KeysToggleBtn.Text = keysOpen and "▼  KEY CONFIGURATION" or "▶  KEY CONFIGURATION"
