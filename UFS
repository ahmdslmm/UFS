local function createSliderControl(parent, yPos, opts)
    local format = opts.format or "%.2f"

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -S(100), 0, S(20))
    Label.Position = UDim2.new(0, S(14), 0, yPos)
    Label.BackgroundTransparency = 1
    Label.Text = opts.label
    Label.TextColor3 = Color3.fromRGB(200, 210, 230)
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = S(12)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = parent

    local InputBox = Instance.new("TextBox")
    InputBox.Size = UDim2.new(0, S(60), 0, S(20))
    InputBox.Position = UDim2.new(1, -S(74), 0, yPos)
    InputBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    InputBox.Text = string.format(format, opts.initial) .. (opts.suffix or "")
    InputBox.TextColor3 = Color3.fromRGB(0, 0, 0)
    InputBox.Font = Enum.Font.GothamSemibold
    InputBox.TextSize = S(12)
    InputBox.ClipsDescendants = true
    InputBox.Parent = parent
    Instance.new("UICorner", InputBox).CornerRadius = UDim.new(0, S(10))

    local SliderBar = Instance.new("TextButton")
    SliderBar.Size = UDim2.new(1, -S(28), 0, S(15))
    SliderBar.Position = UDim2.new(0, S(14), 0, yPos + S(28))
    SliderBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SliderBar.Text = ""
    SliderBar.AutoButtonColor = false
    SliderBar.ZIndex = 1
    SliderBar.Parent = parent

    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new((opts.initial - opts.min) / (opts.max - opts.min), 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(40, 90, 180)
    SliderFill.BorderSizePixel = 0
    SliderFill.ZIndex = 0
    SliderFill.Parent = SliderBar

    local SliderThumb = Instance.new("Frame")
    SliderThumb.Name = "Thumb"
    SliderThumb.Size = UDim2.new(0, S(14), 0, S(14))
    SliderThumb.AnchorPoint = Vector2.new(0.5, 0.5)
    SliderThumb.Position = UDim2.new((opts.initial - opts.min) / (opts.max - opts.min), 0, 0.5, 0)
    SliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SliderThumb.BorderSizePixel = 0
    SliderThumb.ZIndex = 2
    SliderThumb.Parent = SliderBar
    Instance.new("UICorner", SliderThumb).CornerRadius = UDim.new(1, 0)

    local ThumbStroke = Instance.new("UIStroke")
    ThumbStroke.Thickness = 2
    ThumbStroke.Color = Color3.fromRGB(40, 90, 180)
    ThumbStroke.Parent = SliderThumb

    local RangeLabel = Instance.new("TextLabel")
    RangeLabel.Size = UDim2.new(1, -S(28), 0, S(14))
    RangeLabel.Position = UDim2.new(0, S(14), 0, yPos + S(13))
    RangeLabel.BackgroundTransparency = 1
    RangeLabel.Text = "Min: " .. string.format(format, opts.min) .. (opts.suffix or "") .. "   Max: " .. string.format(format, opts.max) .. (opts.suffix or "")
    RangeLabel.TextColor3 = Color3.fromRGB(140, 150, 170)
    RangeLabel.Font = Enum.Font.Gotham
    RangeLabel.TextSize = S(9.5)
    RangeLabel.TextXAlignment = Enum.TextXAlignment.Left
    RangeLabel.Parent = parent

    local currentVal = opts.initial

    local function setValue(val, skipTextUpdate)
        val = math.clamp(val, opts.min, opts.max)
        currentVal = val
        local pct = (val - opts.min) / (opts.max - opts.min)
        SliderFill.Size = UDim2.new(pct, 0, 1, 0)
        SliderThumb.Position = UDim2.new(pct, 0, 0.5, 0)
        if not skipTextUpdate then
            InputBox.Text = string.format(format, val) .. (opts.suffix or "")
        end
        opts.onChange(val)
    end

    trackConnection(InputBox.FocusLost:Connect(function()
        local numText = InputBox.Text:gsub("[^%d%.%-]", "")
        local num = tonumber(numText)
        if num then
            setValue(num)
        else
            InputBox.Text = string.format(format, currentVal) .. (opts.suffix or "")
        end
    end))

    local dragging = false
    trackConnection(SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end))
    trackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end))
    trackConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = UserInputService:GetMouseLocation().X
            local barPos = SliderBar.AbsolutePosition.X
            local barWidth = SliderBar.AbsoluteSize.X
            local pct = math.clamp((mousePos - barPos) / barWidth, 0, 1)
            setValue(opts.min + (pct * (opts.max - opts.min)))
        end
    end))

    return {
        setValue = setValue,
        getValue = function() return currentVal end,
    }
end

