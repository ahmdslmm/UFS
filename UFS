        end
    end
    if hideAllActive then
        HideAllTopButton.BackgroundColor3 = Color3.fromRGB(70, 150, 55)
        HideAllTopButton.Text = "HIDE ALL : ON"
    else
        HideAllTopButton.BackgroundColor3 = Color3.fromRGB(40, 90, 180)
