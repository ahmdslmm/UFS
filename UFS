trackConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if active then
        if input.KeyCode == SPEED_UP_KEY then
            forwardSpeedControl.setValue(forwardSpeedControl.getValue() + speedStep)
            sideSpeedControl.setValue(sideSpeedControl.getValue() + speedStep)
            return
        elseif input.KeyCode == SPEED_DOWN_KEY then
            forwardSpeedControl.setValue(forwardSpeedControl.getValue() - speedStep)
            sideSpeedControl.setValue(sideSpeedControl.getValue() - speedStep)
            return
        elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            if not tripodActive then
                mouseLocked = not mouseLocked
            end
        end
    end

    if processed then return end
    
    if input.KeyCode == MENU_KEY then
        menuVisible = not menuVisible
        toggleMenu(menuVisible)
    end
    
    if input.KeyCode == TOGGLE_KEY then
        toggleFreecam()
    end

    if input.KeyCode == HIDE_UI_KEY then
        toggleGameUI()
    end

    if input.KeyCode == GRID_TOGGLE_KEY then
        toggleGridOverlay()
    end

    if input.KeyCode == FOG_TOGGLE_KEY then
        toggleFog()
    end

    if input.KeyCode == DOF_TOGGLE_KEY then
        toggleDOF()
    end
    
    if active and not tripodActive then
        if input.KeyCode == Enum.KeyCode.W then movement.W = 1 end
        if input.KeyCode == Enum.KeyCode.S then movement.S = 1 end
        if input.KeyCode == Enum.KeyCode.A then movement.A = 1 end
        if input.KeyCode == Enum.KeyCode.D then movement.D = 1 end
        if input.KeyCode == Enum.KeyCode.E then movement.E = 1 end 
        if input.KeyCode == Enum.KeyCode.Q then movement.Q = 1 end 
    end

    if active then
        if input.KeyCode == Enum.KeyCode.Z then movement.Z = 1 end
        if input.KeyCode == Enum.KeyCode.X then movement.X = 1 end
        if input.KeyCode == Enum.KeyCode.C then rotationZ = 0 end
        
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mouseLocation = UserInputService:GetMouseLocation()
            local insetY = GuiService:GetGuiInset().Y
            local ray = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y - insetY)
            
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            if player.Character then
                raycastParams.FilterDescendantsInstances = {player.Character}
            end
            
            local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, raycastParams)
            if hit and hit.Instance then
                local model = hit.Instance:FindFirstAncestorOfClass("Model")
                
                if model and model:FindFirstChildOfClass("Humanoid") then
                    local targetPlayer = Players:GetPlayerFromCharacter(model)
                    
                    if targetPlayer then
                        for id in pairs(targets) do 
                            targets[id] = nil 
                        end
                        
                        targets[targetPlayer.UserId] = targetPlayer
                        refreshPlayerList()
                        
                        trackingMode = "HumanoidRootPart"
                        refreshTrackButtonColors()
                        if not tripodActive then
                            snapCameraToTarget(false)
                        end
                    else
                        local focusPart = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or hit.Instance
                        customOrbitCenter = focusPart.Position
                        
                        trackingMode = "Custom"
                        refreshTrackButtonColors()
                        if not tripodActive then
                            snapCameraToTarget(false)
                        end
                    end
                end
            end
        end
    end
end))

