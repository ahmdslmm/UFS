function setCharacterHidden(char, hidden)
    if not char then return end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BasePart") or desc:IsA("Decal") then
            if hidden then
                if genv.CFS_HiddenParts[desc] == nil then genv.CFS_HiddenParts[desc] = desc.Transparency end
                desc.Transparency = 1
            else
                if genv.CFS_HiddenParts[desc] ~= nil then desc.Transparency = genv.CFS_HiddenParts[desc]; genv.CFS_HiddenParts[desc] = nil end
            end
        elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            if hidden then
                if genv.CFS_HiddenParts[desc] == nil then genv.CFS_HiddenParts[desc] = desc.Enabled end
                desc.Enabled = false
            else
                if genv.CFS_HiddenParts[desc] ~= nil then desc.Enabled = genv.CFS_HiddenParts[desc]; genv.CFS_HiddenParts[desc] = nil end
            end
        end
    end
end

