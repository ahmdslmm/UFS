function toggleFreecam()
    active = not active
    mouseLocked = false
    updateStatusIndicator()
    if active then
        savedDefaultFov = camera.FieldOfView
        setMovementEnabled(tripodMode)
        camera.CameraType = Enum.CameraType.Scriptable
        camCFrame = camera.CFrame

        for k, _ in pairs(smoothedMovement) do smoothedMovement[k] = 0 end

        local rx, ry, _ = camera.CFrame:ToEulerAnglesYXZ()
        targetRotationX = math.deg(ry)
        targetRotationY = math.clamp(math.deg(rx), -85, 85)
        rotationX = targetRotationX
        rotationY = targetRotationY

        if not tripodMode then
            local center = getTrackingCenter()
            if center then
                orbitDistance = (camera.CFrame.Position - center).Magnitude
                if orbitDistance < 4 then orbitDistance = 20 end
                targetOrbitDistance = orbitDistance
            end
        end
    else
        setMovementEnabled(true)
        camera.CameraType = Enum.CameraType.Custom
        camera.FieldOfView = savedDefaultFov
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end

