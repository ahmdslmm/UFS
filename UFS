genv.IY_Style_Freecam = trackConnection(RunService.RenderStepped:Connect(function(dt)
    if not AppState.active then return end
    local currentCam = workspace.CurrentCamera; if not currentCam then return end

    -- PAKSA KARAKTER DIAM & KAKU (MENGKALIBRASI ANTI-CHEAT/SPRINT SCRIPT MAP)
    if not AppState.tripodActive then
        pcall(function()
            local hrp = getHumanoidRootPart()
            if hrp and not hrp.Anchored then hrp.Anchored = true end
        end)
    end

    local fovLerpSpeed = math.clamp(CamConfig.movementSmoothness, 1, 30)
    currentCam.FieldOfView = currentCam.FieldOfView + (CamConfig.targetFov - currentCam.FieldOfView) * math.clamp(dt * fovLerpSpeed, 0, 1)

    local trackingCenter = getTrackingCenter()
    local isPanActive = (AppState.mouseLocked and not AppState.tripodActive) or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if isPanActive then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        local delta = UserInputService:GetMouseDelta(); local activeSens = CamConfig.sensitivity
        if trackingCenter then activeSens = CamConfig.sensitivity * math.clamp(15 / math.max(orbitDistance, 1), 0.08, 1.5) end
        targetRotationX = targetRotationX - (delta.X * activeSens); targetRotationY = math.clamp(targetRotationY - (delta.Y * activeSens), -85, 85)
    else UserInputService.MouseBehavior = Enum.MouseBehavior.Default end
    
    local panLerp = math.clamp(CamConfig.mouseSmoothness, 1, 30); local moveLerp = math.clamp(CamConfig.movementSmoothness, 1, 30); local lerpAlpha = math.clamp(dt * moveLerp, 0, 1)
    
    smoothedMovement.Z = smoothedMovement.Z + (movement.Z - smoothedMovement.Z) * lerpAlpha; smoothedMovement.X = smoothedMovement.X + (movement.X - smoothedMovement.X) * lerpAlpha
    rotationZ = rotationZ + (CamConfig.tiltSpeed * dt * (smoothedMovement.Z - smoothedMovement.X))

    if AppState.tripodActive then
        tripodPosition = tripodPosition or currentCam.CFrame.Position
        if trackingCenter then
            local lookRotation = CFrame.lookAt(tripodPosition, trackingCenter + Vector3.new(0, CamConfig.cameraHeightOffset, 0)) * CFrame.Angles(0, 0, math.rad(rotationZ))
            currentCam.CFrame = currentCam.CFrame:Lerp(lookRotation, math.clamp(dt * panLerp, 0, 1))
            local rx, ry, _ = lookRotation:ToEulerAnglesYXZ(); targetRotationX = math.deg(ry); targetRotationY = math.clamp(math.deg(rx), -85, 85); rotationX = targetRotationX; rotationY = targetRotationY
        else
            rotationX = rotationX + (targetRotationX - rotationX) * math.clamp(dt * panLerp, 0, 1); rotationY = rotationY + (targetRotationY - rotationY) * math.clamp(dt * panLerp, 0, 1)
            currentCam.CFrame = CFrame.new(tripodPosition) * (CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0) * CFrame.Angles(0, 0, math.rad(rotationZ)))
        end
        return
    end

    local cFwd = tonumber(CamConfig.forwardSpeed) or 1.0; local cSide = tonumber(CamConfig.sideSpeed) or 1.0
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then cFwd = cFwd * CamConfig.shiftMultiplier; cSide = cSide * CamConfig.shiftMultiplier end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then cFwd = cFwd / CamConfig.slowMultiplier; cSide = cSide / CamConfig.slowMultiplier end

    smoothedMovement.W = smoothedMovement.W + (movement.W - smoothedMovement.W) * lerpAlpha; smoothedMovement.S = smoothedMovement.S + (movement.S - smoothedMovement.S) * lerpAlpha; smoothedMovement.A = smoothedMovement.A + (movement.A - smoothedMovement.A) * lerpAlpha; smoothedMovement.D = smoothedMovement.D + (movement.D - smoothedMovement.D) * lerpAlpha; smoothedMovement.E = smoothedMovement.E + (movement.E - smoothedMovement.E) * lerpAlpha; smoothedMovement.Q = smoothedMovement.Q + (movement.Q - smoothedMovement.Q) * lerpAlpha

    if trackingCenter then
        local orbitScale = math.clamp(15 / math.max(orbitDistance, 1), 0.05, 2.0); local sideAngular = cSide * 65 * dt * orbitScale; local fwdZoom = cFwd * math.clamp(orbitDistance * 0.6, 8, 40) * dt; local vertAngular = sideAngular * CamConfig.verticalSpeed
        targetOrbitDistance = math.max(targetOrbitDistance + (fwdZoom * (smoothedMovement.S - smoothedMovement.W)), 2)
        orbitDistance = orbitDistance + (targetOrbitDistance - orbitDistance) * math.clamp(dt * math.clamp(CamConfig.movementSmoothness, 1, 30), 0, 1)
        targetRotationX = targetRotationX + (sideAngular * (smoothedMovement.D - smoothedMovement.A)); targetRotationY = math.clamp(targetRotationY + (vertAngular * (smoothedMovement.Q - smoothedMovement.E)), -85, 85)
    end

    rotationX = rotationX + (targetRotationX - rotationX) * math.clamp(dt * panLerp, 0, 1); rotationY = rotationY + (targetRotationY - rotationY) * math.clamp(dt * panLerp, 0, 1)
    local rotationMatrix = CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0) * CFrame.Angles(0, 0, math.rad(rotationZ))

    if trackingCenter then
        camCFrame = CFrame.new((trackingCenter + Vector3.new(0, CamConfig.cameraHeightOffset, 0)) + (rotationMatrix * Vector3.new(0, 0, orbitDistance))) * rotationMatrix
        currentCam.CFrame = currentCam.CFrame:Lerp(camCFrame, math.clamp(dt * (31 - math.clamp(CamConfig.smoothingWeight, 1, 30)), 0, 1))
    else
        local moveVector = (CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0)):VectorToWorldSpace(Vector3.new((smoothedMovement.D - smoothedMovement.A) * cSide, 0, (smoothedMovement.S - smoothedMovement.W) * cFwd)) * (15 * dt)
        camCFrame = camCFrame + (moveVector + Vector3.new(0, (smoothedMovement.E - smoothedMovement.Q) * (cFwd * CamConfig.verticalSpeed * 15 * dt), 0))
        local rawTarget = CFrame.new(camCFrame.Position) * rotationMatrix
        if isPanActive then currentCam.CFrame = rawTarget else currentCam.CFrame = currentCam.CFrame:Lerp(rawTarget, math.clamp(dt * 15, 0, 1)) end
    end
end))
