local function createSliderControl(parent, yPos, opts)
    local format = opts.format or "%.2f"
    local Label = Instance.new("TextLabel", parent); Label.Size = UDim2.new(1, -S(100), 0, S(20)); Label.Position = UDim2.new(0, S(14), 0, yPos); Label.BackgroundTransparency = 1; Label.Text = opts.label; Label.TextColor3 = Color3.fromRGB(200, 210, 230); Label.Font = Enum.Font.GothamMedium; Label.TextSize = S(12); Label.TextXAlignment = Enum.TextXAlignment.Left
    local InputBox = Instance.new("TextBox", parent); InputBox.Size = UDim2.new(0, S(60), 0, S(20)); InputBox.Position = UDim2.new(1, -S(74), 0, yPos); InputBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255); InputBox.Text = string.format(format, opts.initial) .. (opts.suffix or ""); InputBox.TextColor3 = Color3.fromRGB(0, 0, 0); InputBox.Font = Enum.Font.GothamMedium; InputBox.TextSize = S(12); InputBox.ClipsDescendants = true
    Instance.new("UICorner", InputBox).CornerRadius = UDim.new(0, S(10))
    local SliderBar = Instance.new("TextButton", parent); SliderBar.Size = UDim2.new(1, -S(28), 0, S(6)); SliderBar.Position = UDim2.new(0, S(14), 0, yPos + S(28)); SliderBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255); SliderBar.Text = ""; SliderBar.AutoButtonColor = false; SliderBar.ZIndex = 1
    Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(1, 0)
    local SliderFill = Instance.new("Frame", SliderBar); SliderFill.Size = UDim2.new((opts.initial - opts.min) / (opts.max - opts.min), 0, 1, 0); SliderFill.BackgroundColor3 = opts.fillColor or Color3.fromRGB(40, 90, 180); SliderFill.BorderSizePixel = 0; SliderFill.ZIndex = 0
    Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)
    local SliderThumb = Instance.new("Frame", SliderBar); SliderThumb.Size = UDim2.new(0, S(12), 0, S(12)); SliderThumb.AnchorPoint = Vector2.new(0.5, 0.5); SliderThumb.Position = UDim2.new((opts.initial - opts.min) / (opts.max - opts.min), 0, 0.5, 0); SliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255); SliderThumb.BorderSizePixel = 0; SliderThumb.ZIndex = 2
    Instance.new("UICorner", SliderThumb).CornerRadius = UDim.new(1, 0)
    local ThumbStroke = Instance.new("UIStroke", SliderThumb); ThumbStroke.Thickness = 2; ThumbStroke.Color = opts.fillColor or Color3.fromRGB(40, 90, 180)
    local RangeLabel = Instance.new("TextLabel", parent); RangeLabel.Size = UDim2.new(1, -S(28), 0, S(14)); RangeLabel.Position = UDim2.new(0, S(14), 0, yPos + S(34)); RangeLabel.BackgroundTransparency = 1; RangeLabel.Text = "Min: " .. string.format(format, opts.min) .. (opts.suffix or "") .. "   Max: " .. string.format(format, opts.max) .. (opts.suffix or ""); RangeLabel.TextColor3 = Color3.fromRGB(140, 150, 170); RangeLabel.Font = Enum.Font.Gotham; RangeLabel.TextSize = S(9.5); RangeLabel.TextXAlignment = Enum.TextXAlignment.Left
    
    local currentVal = opts.initial
    local function setValue(val, skipTextUpdate)
        val = math.clamp(val, opts.min, opts.max); currentVal = val; local pct = (val - opts.min) / (opts.max - opts.min)
        SliderFill.Size = UDim2.new(pct, 0, 1, 0); SliderThumb.Position = UDim2.new(pct, 0, 0.5, 0)
        if not skipTextUpdate then InputBox.Text = string.format(format, val) .. (opts.suffix or "") end
        if opts.onChange then pcall(function() opts.onChange(val) end) end
    end
    trackConnection(InputBox.FocusLost:Connect(function()
        local numText = InputBox.Text:gsub("[^%d%.%-]", ""); local num = tonumber(numText)
        if num then setValue(num) else InputBox.Text = string.format(format, currentVal) .. (opts.suffix or "") end
    end))
    local dragging = false
    trackConnection(SliderBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end))
    trackConnection(UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end))
    trackConnection(UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pct = math.clamp((UserInputService:GetMouseLocation().X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
            setValue(opts.min + (pct * (opts.max - opts.min)))
        end
    end))
    return { setValue = setValue, getValue = function() return currentVal end }
end

