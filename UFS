        TweenService:Create(KeysContainer, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, targetKeysY), Size = UDim2.new(1, 0, 0, keysH)}):Play()
        
        TweenService:Create(BottomContainer, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, targetBottomY)}):Play()
        if not minimized then
            TweenService:Create(MainCanvas, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, FULL_CANVAS_WIDTH, 0, totalCanvasH)}):Play()
