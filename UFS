local uiHidden = false
local hiddenSavedGuis = {}
local uiHideConnections = {}
local originalTextBubbleChat = true
local originalLegacyBubbleChat = true
local originalProximityPrompt = true 

local function processOverheadHiding(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if hum and hum.DisplayDistanceType ~= Enum.HumanoidDisplayDistanceType.None then
        hiddenSavedGuis[hum] = hum.DisplayDistanceType
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BillboardGui") and desc.Enabled then
            desc.Enabled = false
            hiddenSavedGuis[desc] = true
        end
    end
    table.insert(uiHideConnections, char.DescendantAdded:Connect(function(desc)
        if uiHidden and desc:IsA("BillboardGui") then
            task.defer(function()
                if desc.Enabled then
                    desc.Enabled = false
                    hiddenSavedGuis[desc] = true
                end
            end)
        end
    end))
end

local function toggleActiveChatBubbles(visible)
    local function scanAndHideBubbles(container)
        if not container then return end
        for _, desc in ipairs(container:GetDescendants()) do
            if desc:IsA("BillboardGui") and (desc.Name:find("Bubble") or desc.Name:find("Chat")) then
                if not visible then
                    if desc.Enabled then
                        desc.Enabled = false
                        hiddenSavedGuis[desc] = true
                    end
                else
                    if hiddenSavedGuis[desc] then
                        desc.Enabled = true
                    end
                end
            end
        end
    end
    scanAndHideBubbles(CoreGui)
    scanAndHideBubbles(playerGui)
end

function toggleGameUI()
    uiHidden = not uiHidden
    if uiHidden then
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        
        pcall(function()
            if TextChatService:FindFirstChild("BubbleChatConfiguration") then
                originalTextBubbleChat = TextChatService.BubbleChatConfiguration.Enabled
                TextChatService.BubbleChatConfiguration.Enabled = false
            end
        end)
        
        pcall(function()
            originalLegacyBubbleChat = ChatService.BubbleChatEnabled
            ChatService.BubbleChatEnabled = false
        end)
        
        toggleActiveChatBubbles(false)

        pcall(function()
            local pps = game:GetService("ProximityPromptService")
            originalProximityPrompt = pps.Enabled
            pps.Enabled = false
        end)
        
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "FreecamUI" and gui.Enabled then
                gui.Enabled = false
                hiddenSavedGuis[gui] = true
            end
        end
        table.insert(uiHideConnections, playerGui.ChildAdded:Connect(function(gui)
            if uiHidden and gui:IsA("ScreenGui") and gui.Name ~= "FreecamUI" then
                task.defer(function()
                    if gui.Enabled then
                        gui.Enabled = false
                        hiddenSavedGuis[gui] = true
                    end
                end)
            end
        end))
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then processOverheadHiding(p.Character) end
            table.insert(uiHideConnections, p.CharacterAdded:Connect(processOverheadHiding))
        end
        table.insert(uiHideConnections, Players.PlayerAdded:Connect(function(p)
            table.insert(uiHideConnections, p.CharacterAdded:Connect(processOverheadHiding))
        end))
        ToggleGameUIButton.Text = "✅ GAME UI HIDDEN"
        ToggleGameUIButton.BackgroundColor3 = Color3.fromRGB(70, 150, 55)
    else
        for _, conn in ipairs(uiHideConnections) do pcall(function() conn:Disconnect() end) end
        uiHideConnections = {}
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
        
        pcall(function()
            if TextChatService:FindFirstChild("BubbleChatConfiguration") then 
                TextChatService.BubbleChatConfiguration.Enabled = originalTextBubbleChat 
            end
        end)
        
        pcall(function()
            ChatService.BubbleChatEnabled = originalLegacyBubbleChat
        end)
        
        toggleActiveChatBubbles(true)

        pcall(function()
            local pps = game:GetService("ProximityPromptService")
            pps.Enabled = originalProximityPrompt
        end)
        
        for obj, val in pairs(hiddenSavedGuis) do
            if obj and obj.Parent then
                if obj:IsA("Humanoid") then 
                    obj.DisplayDistanceType = val 
                else 
                    obj.Enabled = true 
                end
            end
        end
        hiddenSavedGuis = {}
        ToggleGameUIButton.Text = "🚫 HIDE GAME UI"
        ToggleGameUIButton.BackgroundColor3 = Color3.fromRGB(40, 90, 180)
    end
end

