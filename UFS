local savedWalkSpeed, savedJumpPower = 16, 50
local FREEZE_ACTION = "UFS_MovementFreeze"

local function getHumanoid() local c = player.Character; if not c then return nil end; return c:FindFirstChildOfClass("Humanoid") end
local function getHumanoidRootPart() local c = player.Character; if not c then return nil end; return c:FindFirstChild("HumanoidRootPart") end

function setMovementEnabled(enabled)
    pcall(function() 
        local ps = player:FindFirstChild("PlayerScripts")
        if ps then
            local pm = ps:FindFirstChild("PlayerModule")
            if pm then
                local m = require(pm)
                if enabled then m:GetControls():Enable() else m:GetControls():Disable() end 
            end
        end
    end)
    
    local humanoid, hrp = getHumanoid(), getHumanoidRootPart()
    
    if enabled then
        pcall(function() ContextActionService:UnbindAction(FREEZE_ACTION) end)
        if humanoid then 
            humanoid.WalkSpeed = (savedWalkSpeed and savedWalkSpeed > 0) and savedWalkSpeed or 16 
            humanoid.JumpPower = (savedJumpPower and savedJumpPower > 0) and savedJumpPower or 50 
        end
        if hrp then hrp.Anchored = false end 
    else
        pcall(function()
            ContextActionService:BindActionAtPriority(
                FREEZE_ACTION,
                function() return Enum.ContextActionResult.Sink end,
                false,
                Enum.ContextActionPriority.High.Value + 100,
                Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
                Enum.KeyCode.Space, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right
            )
        end)
        if humanoid then 
            if humanoid.WalkSpeed > 0 then savedWalkSpeed = humanoid.WalkSpeed end
            if humanoid.JumpPower > 0 then savedJumpPower = humanoid.JumpPower end
            humanoid.WalkSpeed = 0; humanoid.JumpPower = 0 
        end
        if hrp then hrp.Anchored = true end 
    end
end

function getTrackingCenter()
    if trackingMode == nil then return nil end
    if trackingMode == "Custom" then return customOrbitCenter end
    local activePositions = {}; local hasTargetSelected = false
    for id, p in pairs(targets) do hasTargetSelected = true; if p and p.Character then local part = p.Character:FindFirstChild(trackingMode); if part then table.insert(activePositions, part.Position) end end end
    if not hasTargetSelected and player.Character then local part = player.Character:FindFirstChild(trackingMode); if part then table.insert(activePositions, part.Position) end end
    if #activePositions > 0 then
        local sum = Vector3.new(0, 0, 0); for _, pos in ipairs(activePositions) do sum = sum + pos end
        return sum / #activePositions
    end
    return nil
end

function snapCameraToTarget(resetAngles)
    if not AppState.active then return end
    local center = getTrackingCenter(); local currentCam = workspace.CurrentCamera
    if not center or not currentCam then return end
    currentCam.CameraType = Enum.CameraType.Scriptable
    if resetAngles then targetRotationX = 0; targetRotationY = -12; rotationZ = 0 end
    rotationX = targetRotationX; rotationY = targetRotationY; targetOrbitDistance = 12; orbitDistance = 12
    local framedCenter = center + Vector3.new(0, CamConfig.cameraHeightOffset, 0)
    local rotationMatrix = CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0) * CFrame.Angles(0, 0, math.rad(rotationZ))
    camCFrame = CFrame.new(framedCenter + (rotationMatrix * Vector3.new(0, 0, orbitDistance))) * rotationMatrix
    currentCam.CFrame = camCFrame
end

function resetCameraOrbit()
    if not AppState.active then return end
    local currentCam = workspace.CurrentCamera; if not currentCam then return end
    currentCam.CameraType = Enum.CameraType.Scriptable
    if AppState.tripodActive then tripodPosition = currentCam.CFrame.Position end
    if getTrackingCenter() and not AppState.tripodActive then snapCameraToTarget(true); return end
    local rx, ry, _ = currentCam.CFrame:ToEulerAnglesYXZ()
    targetRotationX = math.deg(ry) or 0; targetRotationY = math.clamp(math.deg(rx) or 0, -85, 85); rotationX = targetRotationX; rotationY = targetRotationY; rotationZ = 0
    camCFrame = currentCam.CFrame; targetOrbitDistance = 20; orbitDistance = 20
end

function toggleFreecam()
    AppState.active = not AppState.active; AppState.mouseLocked = false; updateFreecamButtonState()
    local currentCam = workspace.CurrentCamera
    if AppState.active and currentCam then
        savedDefaultFov = currentCam.FieldOfView; currentCam.CameraType = Enum.CameraType.Scriptable; camCFrame = currentCam.CFrame; tripodPosition = currentCam.CFrame.Position
        if AppState.tripodActive then setMovementEnabled(true) else setMovementEnabled(false) end
        for k, _ in pairs(smoothedMovement) do smoothedMovement[k] = 0 end
        local rx, ry, _ = currentCam.CFrame:ToEulerAnglesYXZ(); targetRotationX = math.deg(ry); targetRotationY = math.clamp(math.deg(rx), -85, 85); rotationX = targetRotationX; rotationY = targetRotationY
        local center = getTrackingCenter()
        if center and not AppState.tripodActive then
            orbitDistance = (currentCam.CFrame.Position - center).Magnitude; if orbitDistance < 4 then orbitDistance = 20 end; targetOrbitDistance = orbitDistance
        end
    else
        setMovementEnabled(true)
        if currentCam then 
            currentCam.CameraType = Enum.CameraType.Custom
            currentCam.FieldOfView = savedDefaultFov 
            local hum = getHumanoid()
            if hum then currentCam.CameraSubject = hum end
        end
        pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
    end
end

