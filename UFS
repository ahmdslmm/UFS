local savedWalkSpeed = 16
local savedJumpPower = 50

local function getHumanoid()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

local function getHumanoidRootPart()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

function setMovementEnabled(enabled)
    pcall(function()
        local PlayerModule = require(player.PlayerScripts:WaitForChild("PlayerModule", 5))
        if PlayerModule then
            local controls = PlayerModule:GetControls()
            if enabled then controls:Enable() else controls:Disable() end
        end
    end)

    local humanoid = getHumanoid()
    local hrp = getHumanoidRootPart()

    if enabled then
        if humanoid then
            humanoid.WalkSpeed = savedWalkSpeed
            humanoid.JumpPower = savedJumpPower
        end
        if hrp then hrp.Anchored = false end 
    else
        if humanoid then
            savedWalkSpeed = humanoid.WalkSpeed
            savedJumpPower = humanoid.JumpPower
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
        end
        if hrp then hrp.Anchored = true end 
    end
end

function getTrackingCenter()
    if trackingMode == nil then return nil end
    
    if trackingMode == "Custom" then
        return customOrbitCenter
    end
    
    local activePositions = {}
    local hasTargetSelected = false
    
    for id, p in pairs(targets) do
        hasTargetSelected = true
        if p and p.Parent == Players and p.Character then
            local part = p.Character:FindFirstChild(trackingMode)
            if part then
                table.insert(activePositions, part.Position)
            end
        end
    end
    
    -- Jika tidak ada pemain lain yang dipilih di roster, otomatis track karakter player sendiri
    if not hasTargetSelected and player.Character then
        local part = player.Character:FindFirstChild(trackingMode)
        if part then
            table.insert(activePositions, part.Position)
        end
    end
    
    if #activePositions > 0 then
        local trackingCenter = Vector3.new(0, 0, 0)
        for _, pos in ipairs(activePositions) do
            trackingCenter = trackingCenter + pos
        end
        return trackingCenter / #activePositions
    end
    return nil
end

local DEFAULT_ORBIT_DISTANCE = 12
local DEFAULT_ROTATION_Y = -12

local function snapCameraToTarget(resetAngles)
    if not active then return end
    local center = getTrackingCenter()
    if not center then return end

    camera.CameraType = Enum.CameraType.Scriptable

    if resetAngles then
        targetRotationX = 0
        targetRotationY = DEFAULT_ROTATION_Y
        rotationZ = 0
    end
    rotationX = targetRotationX
    rotationY = targetRotationY
    targetOrbitDistance = DEFAULT_ORBIT_DISTANCE
    orbitDistance = DEFAULT_ORBIT_DISTANCE

    local framedCenter = center + Vector3.new(0, cameraHeightOffset, 0)
    local rotationMatrix = CFrame.Angles(0, math.rad(rotationX), 0) * CFrame.Angles(math.rad(rotationY), 0, 0) * CFrame.Angles(0, 0, math.rad(rotationZ))
    local targetPos = framedCenter + (rotationMatrix * Vector3.new(0, 0, orbitDistance))

    camCFrame = CFrame.new(targetPos) * rotationMatrix
    camera.CFrame = camCFrame
end

function resetCameraOrbit()
    if not active then return end
    camera.CameraType = Enum.CameraType.Scriptable

    if tripodActive then
        tripodPosition = camera.CFrame.Position
    end

    local center = getTrackingCenter()
    if center and not tripodActive then
        snapCameraToTarget(true)
        return
    end

    local rx, ry, _ = camera.CFrame:ToEulerAnglesYXZ()
    local newRotX = math.deg(ry)
    local newRotY = math.deg(rx)
    if newRotX ~= newRotX then newRotX = 0 end 
    if newRotY ~= newRotY then newRotY = 0 end 
    targetRotationX = newRotX
    targetRotationY = math.clamp(newRotY, -85, 85)
    
    rotationX = targetRotationX
    rotationY = targetRotationY
    rotationZ = 0

    camCFrame = camera.CFrame
    targetOrbitDistance = 20
    orbitDistance = 20
end

function toggleFreecam()
    active = not active
    mouseLocked = false
    updateFreecamButtonState()
    if active then
        savedDefaultFov = camera.FieldOfView
        camera.CameraType = Enum.CameraType.Scriptable
        camCFrame = camera.CFrame
        tripodPosition = camera.CFrame.Position

        if tripodActive then
            setMovementEnabled(true)
        else
            setMovementEnabled(false)
        end

        for k, _ in pairs(smoothedMovement) do smoothedMovement[k] = 0 end

        local rx, ry, _ = camera.CFrame:ToEulerAnglesYXZ()
        targetRotationX = math.deg(ry)
        targetRotationY = math.clamp(math.deg(rx), -85, 85)
        rotationX = targetRotationX
        rotationY = targetRotationY

        local center = getTrackingCenter()
        if center and not tripodActive then
            orbitDistance = (camera.CFrame.Position - center).Magnitude
            if orbitDistance < 4 then orbitDistance = 20 end
            targetOrbitDistance = orbitDistance
        end
    else
        setMovementEnabled(true)
        camera.CameraType = Enum.CameraType.Custom
        camera.FieldOfView = savedDefaultFov
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
end

