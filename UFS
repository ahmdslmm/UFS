function setCharacterHidden(char, hidden)
    if not char then return end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BasePart") or desc:IsA("Decal") then
            if hidden then
                if genv.CFS_HiddenParts[desc] == nil then
                    genv.CFS_HiddenParts[desc] = desc.Transparency
                end
                desc.Transparency = 1
            else
                if genv.CFS_HiddenParts[desc] ~= nil then
                    desc.Transparency = genv.CFS_HiddenParts[desc]
                    genv.CFS_HiddenParts[desc] = nil
                end
            end
        elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
            if hidden then
                if genv.CFS_HiddenParts[desc] == nil then
                    genv.CFS_HiddenParts[desc] = desc.Enabled
                end
                desc.Enabled = false
            else
                if genv.CFS_HiddenParts[desc] ~= nil then
                    desc.Enabled = genv.CFS_HiddenParts[desc]
                    genv.CFS_HiddenParts[desc] = nil
                end
            end
        end
    end
end

function updateHideAllButton()
    local allHidden = true
    local playerList = Players:GetPlayers()
    if #playerList == 0 then
        allHidden = false
    else
        for _, p in ipairs(playerList) do
            if not hiddenPlayers[p.UserId] then
                allHidden = false
                break
            end
        end
    end

    hideAllActive = allHidden
    if hideAllActive then
        HideAllTopButton.BackgroundColor3 = Color3.fromRGB(70, 150, 55)
        HideAllTopButton.Text = "HIDE ALL : ON"
    else
        HideAllTopButton.BackgroundColor3 = Color3.fromRGB(40, 90, 180)
        HideAllTopButton.Text = "HIDE ALL : OFF"
    end
end

HideAllTopButton.MouseButton1Click:Connect(function()
    hideAllActive = not hideAllActive
    for _, p in ipairs(Players:GetPlayers()) do
        hiddenPlayers[p.UserId] = hideAllActive
        if p.Character then
