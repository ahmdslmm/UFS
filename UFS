    else
        SlidersContainer.Size = UDim2.new(1, 0, 0, slidersH)
        
        VisualsToggleBtn.Position = UDim2.new(0, S(14), 0, targetVisualsToggleY)
        VisualsContainer.Position = UDim2.new(0, 0, 0, targetVisualsY)
        VisualsContainer.Size = UDim2.new(1, 0, 0, visualsH)

