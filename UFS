-- ==========================================
-- 1. AUTO CLEANUP & PRE-EXECUTION SETUP
-- ==========================================
local genv = (getgenv and getgenv()) or _G

if genv.CFS_Connections then
    for _, conn in ipairs(genv.CFS_Connections) do
        pcall(function() conn:Disconnect() end)
    end
end
genv.CFS_Connections = {}

local function trackConnection(conn)
    table.insert(genv.CFS_Connections, conn)
    return conn
end

-- Restore Transparansi Karakter Sebelumnya
if genv.CFS_HiddenParts then
    for part, originalTrans in pairs(genv.CFS_HiddenParts) do
        pcall(function()
            if part and part.Parent then
                if part:IsA("BasePart") or part:IsA("Decal") then
                    part.Transparency = originalTrans
                elseif part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
                    part.Enabled = originalTrans
                end
            end
        end)
    end
end
genv.CFS_HiddenParts = {}

-- Restore Exposure Sebelumnya
if genv.CFS_DefaultExposure ~= nil then
    pcall(function()
        game:GetService("Lighting").ExposureCompensation = genv.CFS_DefaultExposure
    end)
end

-- Hapus ColorCorrection Effect Lama
pcall(function()
    local oldEffect = game:GetService("Lighting"):FindFirstChild("CFS_VisualModifier")
    if oldEffect then oldEffect:Destroy() end
end)

-- Restore State Karakter & Kamera
if genv.IY_Style_Freecam then
    genv.IY_Style_Freecam:Disconnect()
    genv.IY_Style_Freecam = nil
    
    local camera = workspace.CurrentCamera
    camera.CameraType = Enum.CameraType.Custom
    camera.FieldOfView = 70
    
    game:GetService("UserInputService").MouseBehavior = Enum.MouseBehavior.Default
    pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.All, true) end)
    
    local oldUi = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("FreecamUI")
    if oldUi then oldUi:Destroy() end

    pcall(function()
        local player = game:GetService("Players").LocalPlayer
        local PlayerModule = require(player.PlayerScripts:WaitForChild("PlayerModule"))
        PlayerModule:GetControls():Enable()
        
        if player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                if hum.WalkSpeed == 0 then hum.WalkSpeed = 16 end
                if hum.JumpPower == 0 then hum.JumpPower = 50 end
            end
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = false end
        end
    end)
end

