local hiddenSavedGuis, uiHideConnections, savedCoreGuiStates = {}, {}, {}
local function processOverheadHiding(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if hum and hum.DisplayDistanceType ~= Enum.HumanoidDisplayDistanceType.None then hiddenSavedGuis[hum] = hum.DisplayDistanceType; hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
    for _, desc in ipairs(char:GetDescendants()) do if desc:IsA("BillboardGui") and desc.Enabled then desc.Enabled = false; hiddenSavedGuis[desc] = true end end
    table.insert(uiHideConnections, char.DescendantAdded:Connect(function(desc) if AppState.uiHidden and desc:IsA("BillboardGui") then task.defer(function() if desc.Enabled then desc.Enabled = false; hiddenSavedGuis[desc] = true end end) end end))
end

local function toggleActiveChatBubbles(visible)
    local function scanAndHideBubbles(container)
        if not container then return end
        for _, desc in ipairs(container:GetDescendants()) do
            if desc:IsA("BillboardGui") and (desc.Name:find("Bubble") or desc.Name:find("Chat")) then
                if not visible then if desc.Enabled then desc.Enabled = false; hiddenSavedGuis[desc] = true end
                else if hiddenSavedGuis[desc] then desc.Enabled = true end end
            end
        end
    end
    pcall(function() scanAndHideBubbles(CoreGui) end); pcall(function() local pg = player:FindFirstChild("PlayerGui"); if pg then scanAndHideBubbles(pg) end end)
end

function toggleGameUI()
    AppState.uiHidden = not AppState.uiHidden
    if AppState.uiHidden then
        savedCoreGuiStates = {}
        for _, coreType in ipairs(Enum.CoreGuiType:GetEnumItems()) do
            if coreType ~= Enum.CoreGuiType.All then local success, isEnabled = pcall(function() return StarterGui:GetCoreGuiEnabled(coreType) end); if success then savedCoreGuiStates[coreType] = isEnabled end end
        end
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        pcall(function() if TextChatService:FindFirstChild("BubbleChatConfiguration") then AppState.originalTextBubbleChat = TextChatService.BubbleChatConfiguration.Enabled; TextChatService.BubbleChatConfiguration.Enabled = false end end)
        pcall(function() AppState.originalLegacyBubbleChat = ChatService.BubbleChatEnabled; ChatService.BubbleChatEnabled = false end)
        toggleActiveChatBubbles(false)
        pcall(function() local pps = game:GetService("ProximityPromptService"); AppState.originalProximityPrompt = pps.Enabled; pps.Enabled = false end)
        
        local pg = player:FindFirstChild("PlayerGui")
        if pg then
            for _, gui in ipairs(pg:GetChildren()) do if gui:IsA("ScreenGui") and gui.Name ~= "FreecamUI_V8_Pro" and gui.Enabled then gui.Enabled = false; hiddenSavedGuis[gui] = true end end
            table.insert(uiHideConnections, pg.ChildAdded:Connect(function(gui) if AppState.uiHidden and gui:IsA("ScreenGui") and gui.Name ~= "FreecamUI_V8_Pro" then task.defer(function() if gui.Enabled then gui.Enabled = false; hiddenSavedGuis[gui] = true end end) end end))
        end
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then processOverheadHiding(p.Character) end; table.insert(uiHideConnections, p.CharacterAdded:Connect(processOverheadHiding)) end
        table.insert(uiHideConnections, Players.PlayerAdded:Connect(function(p) table.insert(uiHideConnections, p.CharacterAdded:Connect(processOverheadHiding)) end))
        UI.ToggleGameUIButton.Text = "HIDE V1"; UI.ToggleGameUIButton.BackgroundColor3 = Color3.fromRGB(70, 150, 55)
    else
        for _, conn in ipairs(uiHideConnections) do pcall(function() conn:Disconnect() end) end; uiHideConnections = {}
        for coreType, wasEnabled in pairs(savedCoreGuiStates) do pcall(function() StarterGui:SetCoreGuiEnabled(coreType, wasEnabled) end) end; savedCoreGuiStates = {}
        pcall(function() if TextChatService:FindFirstChild("BubbleChatConfiguration") then TextChatService.BubbleChatConfiguration.Enabled = AppState.originalTextBubbleChat end end)
        pcall(function() ChatService.BubbleChatEnabled = AppState.originalLegacyBubbleChat end); toggleActiveChatBubbles(true)
        pcall(function() game:GetService("ProximityPromptService").Enabled = AppState.originalProximityPrompt end)
        for obj, val in pairs(hiddenSavedGuis) do if obj and obj.Parent then if obj:IsA("Humanoid") then obj.DisplayDistanceType = val else obj.Enabled = true end end end; hiddenSavedGuis = {}
        UI.ToggleGameUIButton.Text = "HIDE V1"; UI.ToggleGameUIButton.BackgroundColor3 = Color3.fromRGB(40, 90, 180)
    end
end

