function updateLayout(animate)
    local time = animate and 0.3 or 0
    local currentY = S(278) 

    local slidersH = slidersOpen and S(490) or 0
    local targetSlidersY = currentY
    currentY = currentY + slidersH + (slidersOpen and S(6) or 0)

