-- HIDE V2 (Advanced Core/Bubble Hider)
local HideV2 = {
    hiddenGUIS = {}, hiddenNames = {}, hiddenBubble = {},
    savedBubbleCfg = nil, savedLegacyBubble = nil,
    BUBBLE_HINTS = { "bubble", "chatbubble", "bubblechat" },
    TARGET_CLASSES = { Frame = true, ImageLabel = true, ScrollingFrame = true }
}

function HideV2.isBubbleLike(obj)
    local n = string.lower(obj.Name)
    for _, h in ipairs(HideV2.BUBBLE_HINTS) do if string.find(n, h, 1, true) then return true end end
    return false
end
function HideV2.isOwnUI(obj)
    local cur = obj
    while cur and cur ~= player:FindFirstChild("PlayerGui") do
        if cur == UI.ScreenGui then return true end; cur = cur.Parent
    end
    return false
end
function HideV2.isTracked(list, obj)
    for _, e in ipairs(list) do if e.obj == obj then return true end end
    return false
end

function HideV2.hideOneGui(obj)
    if not HideV2.TARGET_CLASSES[obj.ClassName] then return end
    if HideV2.isOwnUI(obj) or HideV2.isTracked(HideV2.hiddenGUIS, obj) or obj.Visible == false then return end
    table.insert(HideV2.hiddenGUIS, { obj = obj, was = obj.Visible }); obj.Visible = false
end
function HideV2.hideGuis()
    local pg = player:FindFirstChild("PlayerGui"); if pg then for _, v in ipairs(pg:GetDescendants()) do pcall(HideV2.hideOneGui, v) end end
end
function HideV2.unhideGuis()
    for i = #HideV2.hiddenGUIS, 1, -1 do
        local e = HideV2.hiddenGUIS[i]
        if e.obj and e.obj.Parent then pcall(function() e.obj.Visible = e.was end) end
        HideV2.hiddenGUIS[i] = nil
    end
end

function HideV2.hideNameOn(obj)
    if obj:IsA("BillboardGui") then
        if HideV2.isBubbleLike(obj) or HideV2.isTracked(HideV2.hiddenNames, obj) or obj.Enabled == false then return end
        table.insert(HideV2.hiddenNames, { obj = obj, was = obj.Enabled }); obj.Enabled = false
    elseif obj:IsA("Humanoid") then
        if HideV2.isTracked(HideV2.hiddenNames, obj) then return end
        table.insert(HideV2.hiddenNames, { obj = obj, was = obj.DisplayDistanceType, health = obj.HealthDisplayDistance, nameD = obj.NameDisplayDistance })
        obj.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; obj.HealthDisplayDistance = 0; obj.NameDisplayDistance = 0
    end
end
function HideV2.hideNames()
    for _, v in ipairs(workspace:GetDescendants()) do pcall(HideV2.hideNameOn, v) end
end
function HideV2.unhideNames()
    for i = #HideV2.hiddenNames, 1, -1 do
        local e = HideV2.hiddenNames[i]
        if e.obj and e.obj.Parent then
            pcall(function()
                if e.obj:IsA("Humanoid") then
                    e.obj.DisplayDistanceType = e.was; e.obj.HealthDisplayDistance = e.health or 100; e.obj.NameDisplayDistance = e.nameD or 100
                else e.obj.Enabled = e.was end
            end)
        end
        HideV2.hiddenNames[i] = nil
    end
end

function HideV2.hideBubbles()
    pcall(function() local cfg = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration"); if cfg then HideV2.savedBubbleCfg = cfg.Enabled; cfg.Enabled = false end end)
    pcall(function() HideV2.savedLegacyBubble = ChatService.BubbleChatEnabled; ChatService.BubbleChatEnabled = false end)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BillboardGui") and HideV2.isBubbleLike(v) and v.Enabled then
            table.insert(HideV2.hiddenBubble, { obj = v, was = v.Enabled }); pcall(function() v.Enabled = false end)
        end
    end
end
function HideV2.unhideBubbles()
    pcall(function() local cfg = TextChatService:FindFirstChildOfClass("BubbleChatConfiguration"); if cfg and HideV2.savedBubbleCfg ~= nil then cfg.Enabled = HideV2.savedBubbleCfg end end)
    pcall(function() if HideV2.savedLegacyBubble ~= nil then ChatService.BubbleChatEnabled = HideV2.savedLegacyBubble end end)
    for i = #HideV2.hiddenBubble, 1, -1 do
        local e = HideV2.hiddenBubble[i]; if e.obj and e.obj.Parent then pcall(function() e.obj.Enabled = e.was end) end; HideV2.hiddenBubble[i] = nil
    end
end

